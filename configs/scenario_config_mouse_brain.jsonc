{
  // array of strings; e.g. ["mouse"], ["human"], ["mouse", "human"]. >=1 entry.
  "species": [
    "mouse"
  ],
  // array of tissues/regions. null if unspecified.
  "tissue": [
    "primary visual cortex"
  ],
  // array of cell types. null if unspecified. This is optional. If null, the embedding should cover all cell types in the given tissue.
  "celltype": null,
  // free-form: "adult", "P15-P20", "E8-E16". null if unspecified.
  "age": "adult",
  // "male" | "female" | "mixed" | null.
  "sex": null,
  // array of conditions (knockouts, treatments, diseases). null = wild-type / healthy.
  "condition": null,
  // free-form string. Optional design focus the agent MUST respect
  // when building the embedding — e.g. resolve specific subtypes,
  // preserve a temporal/maturation gradient, emphasize a signaling
  // pathway. Refines emphasis WITHIN the literature-grounding rules;
  // does not license ungrounded modules. null if unspecified.
  "notes": null
}